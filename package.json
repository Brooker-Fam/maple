{
  "name": "maple",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "migrate": "tsx src/lib/migrate.ts",
    "build": "pnpm run migrate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check:maple-feed": "tsx scripts/maple-feed-check.ts",
    "check:maple-care": "tsx scripts/maple-care-check.ts",
    "check:maple-nutrition": "tsx scripts/maple-nutrition-check.ts",
    "check:maple-nutrition-ui": "node scripts/nutrition-ui-check/run.mjs",
    "check:maple-nutrition-chat-ui": "node scripts/nutrition-chat-ui/run.mjs",
    "check:maple-native": "tsx scripts/maple-native-check.ts",
    "check:maple-chat": "tsx scripts/maple-chat-check.ts && tsx scripts/maple-chat-questions-check.ts && tsx scripts/maple-chat-charts-check.ts && tsx scripts/maple-chat-progress-check.ts && tsx scripts/maple-chat-queue-check.ts && tsx scripts/maple-chat-receipts-check.ts && tsx scripts/maple-chat-navigation-check.ts",
    "check:maple-chat-ui": "node scripts/chat-ui-check/run.mjs && node scripts/chat-settings-ui-check/run.mjs && node scripts/chat-search-ui/run.mjs && node scripts/chat-entrypoints-ui/run.mjs",
    "check:site": "tsx scripts/site-check.ts",
    "check:email": "tsx scripts/email-check.ts",
    "check:analytics": "tsx scripts/analytics-check.ts && tsx scripts/analytics-client-check.ts && tsx scripts/analytics-flow-check.ts && tsx scripts/analytics-errors-check.ts && tsx scripts/analytics-lifecycle-check.ts && tsx scripts/analytics-monitor-check.ts",
    "smoke:analytics": "tsx scripts/analytics-smoke.ts",
    "check:read-only": "tsx scripts/read-only-check.ts",
    "check:usage-alerts": "tsx scripts/usage-alerts-check.ts",
    "check:usage-health": "node --test scripts/usage-health-monitor.check.mjs",
    "check:maple-growth": "tsx scripts/maple-growth-check.ts",
    "check:maple-epic": "tsx scripts/maple-epic-fhir-check.ts && tsx scripts/maple-epic-store-check.ts && tsx scripts/maple-epic-flow-check.ts",
    "check:maple-epic-ui": "node scripts/epic-ui-check/run.mjs",
    "check:maple-tenancy": "tsx scripts/tenancy/run.ts",
    "check:maple-parity": "tsx scripts/tenancy/parity/run.ts",
    "check:maple-time-edit": "tsx scripts/maple-time-edit-check.ts",
    "check:maple-patterns-ui": "node scripts/patterns-ui-check/run.mjs",
    "check:maple-patterns": "tsx scripts/maple-clock-spans-check.ts && tsx scripts/maple-pattern-data-check.ts",
    "check:maple-first-use-ui": "node scripts/first-use-ui/run.mjs",
    "check:maple-lantern-ui": "node scripts/lantern-ui-check/run.mjs",
    "check:apple-auth": "tsx scripts/apple-auth-check.ts",
    "check:email-auth": "tsx scripts/email-auth-check.ts",
    "check:signin": "tsx scripts/signin-flow-check.ts",
    "check:maple-sync": "node scripts/maple-sync-check/run.mjs",
    "check:maple-feed-status": "tsx scripts/maple-feed-status-check.ts",
    "check:maple-diagnostics": "tsx scripts/maple-diagnostics-check.ts",
    "check:maple-ui-review": "node scripts/ui-review-check.mjs",
    "check:maple-ui-recovery": "node scripts/ui-recovery-check.mjs",
    "check:maple-settings-ui": "node scripts/settings-ui/run.mjs && node scripts/shortcuts/check-ui.mjs setup && node scripts/shortcuts/check-ui.mjs retry && node scripts/shortcuts/check-ui.mjs revoke && node scripts/shortcuts/check-ui.mjs returning"
  },
  "dependencies": {
    "@ai-sdk/react": "4.0.45",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@neondatabase/serverless": "^1.0.2",
    "@vercel/blob": "^2.5.0",
    "ai": "7.0.42",
    "framer-motion": "^12.34.3",
    "google-auth-library": "^10.6.2",
    "marked": "18.1.1",
    "mcp-handler": "^1.1.0",
    "next": "16.1.6",
    "posthog-node": "^5.29.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "resend": "6.34.1",
    "web-push": "3.6.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "3.6.4",
    "esbuild": "0.25.10",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "playwright": "1.56.1",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
